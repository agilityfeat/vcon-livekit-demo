# -----------------------------------------------------------------------------
# Local application configuration for the vCon + LiveKit demo.
#
# Copy this file to `.env` (which is gitignored) and populate the values from
# the deployed CloudFormation stack Outputs:
#
#   aws cloudformation describe-stacks \
#     --stack-name vcon-livekit-demo \
#     --query "Stacks[0].Outputs" \
#     --output table
#
# Map the Output keys to the variables below:
#   BucketName      -> BUCKET_NAME
#   StateMachineArn -> STATE_MACHINE_ARN
#   Region          -> AWS_REGION
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# LiveKit voice agent configuration.
#
# Required to run the live agent (`python -m vcon_agent.agent dev` / `console`).
# Obtain LiveKit values from your LiveKit Cloud project or self-hosted server;
# obtain the STT/TTS/LLM keys from the respective provider dashboards.
# -----------------------------------------------------------------------------

# LiveKit server connection
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=

# ElevenLabs (text-to-speech)
ELEVEN_API_KEY=

# LLM provider (OpenAI by default)
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# AWS enrichment backend configuration.
#
# OPTIONAL: when these are unset, the agent persists the vCon
# skeleton to a local file for standalone demo instead of S3 / Step Functions.
#
# Recording via egress: BUCKET_NAME + AWS_REGION together with the
# LiveKit creds above (LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET) are
# what enable the live audio egress to S3 (unified StartEgress API with an
# audio-only template source). When BUCKET_NAME (or
# any of the LiveKit creds) is unset, the agent skips egress gracefully and the
# standalone local demo still runs.
# -----------------------------------------------------------------------------

BUCKET_NAME=
STATE_MACHINE_ARN=
AWS_REGION=

# -----------------------------------------------------------------------------
# AWS credentials for the S3 egress upload, OPTIONAL.
#
# Used as the LiveKit Egress S3 upload credentials when present. If left unset,
# the egress falls back to the instance role.
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
